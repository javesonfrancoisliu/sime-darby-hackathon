# Copy to .env for local dev.
PORT=3001
SERVICE_NAME=sdh-api-local
TABLE_NAME=sdh-local-main
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
# Set to false to switch off the X-Demo-User sign-in, GET /api/demo/users and coordinator creation.
# ALLOW_DEMO_IDENTITY=true
# Bedrock model or inference profile id for AI re-ranking; empty means rules only.
# MATCHING_AI_MODEL_ID=
# Milliseconds to wait for the model before falling back to rules (default 3000).
# MATCHING_AI_TIMEOUT_MS=
