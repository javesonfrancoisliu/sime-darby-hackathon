# Copy to .env for local dev.
PORT=3001
# Simulated sign-in; only the exact value "true" enables it. Never set it on a deployed API.
DEMO_AUTH_ENABLED=true
# From the Terraform outputs; setting both enables Authorization: Bearer sign-in.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
SERVICE_NAME=sdh-api-local
TABLE_NAME=sdh-local-main
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
# AI re-ranking with the Claude API. Never put the API key itself here: the API reads it from this
# SSM parameter with your own AWS profile. Leave MATCHING_AI_MODEL_ID empty for rules only.
# MATCHING_AI_MODEL_ID=claude-haiku-5-5
# ANTHROPIC_API_KEY_PARAM=/sime-darby-hackathon/dev/anthropic-api-key
# AWS_PROFILE=your-aws-cli-profile
# AWS_REGION=ap-southeast-5
# Milliseconds to wait for the model before falling back to rules (default 3000).
# MATCHING_AI_TIMEOUT_MS=9000
