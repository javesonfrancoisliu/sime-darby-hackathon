{
  "name": "@sdh/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DEMO_AUTH_ENABLED=true tsx watch --env-file-if-exists=.env src/local.ts",
    "build": "rm -rf dist && pnpm run build:core && pnpm run build:matching",
    "build:core": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=esm --sourcemap --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=dist/core/handler.mjs",
    "build:matching": "esbuild src/matchingHandler.ts --bundle --platform=node --target=node24 --format=esm --sourcemap --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=dist/matching/handler.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:setup": "tsx --env-file-if-exists=.env scripts/setup-local-table.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1150.0",
    "@aws-sdk/client-dynamodb": "^3.1150.0",
    "@aws-sdk/lib-dynamodb": "^3.1150.0",
    "@sdh/contracts": "workspace:*",
    "aws-jwt-verify": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sdh/config": "workspace:*",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
