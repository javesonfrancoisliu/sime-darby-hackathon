aws_region                  = "<region>"
aws_profile                 = "<profile>"
project                     = "sime-darby-hackathon"
environment                 = "dev"
table_deletion_protection   = false
cognito_deletion_protection = false
# Set true only for a throwaway demo stack: the dev API is public and sign-in is simulated.
demo_auth_enabled = false

# Optional overrides (defaults shown)
# log_retention_days       = 14
# api_throttle_burst_limit = 50
# api_throttle_rate_limit  = 25
# cloudfront_price_class   = "PriceClass_200"
# developer_principal_arns = ["arn:aws:iam::<developer-account-id>:user/<name>"]
# developer_sso_role_arns  = ["arn:aws:iam::<developer-account-id>:role/aws-reserved/sso.amazonaws.com/<region>/AWSReservedSSO_<set>_<id>"]
